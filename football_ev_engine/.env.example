# --- Required ---------------------------------------------------------------
# The Odds API key (https://the-odds-api.com). Free tier: 500 credits/month;
# one agent run costs 10 (5 leagues x 2 markets), +2 while the Nations League is on.
ODDS_API_KEY=your_odds_api_key
# Telegram: create a bot with @BotFather, then get your chat id (see README).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_personal_or_channel_chat_id

# --- Agent rules ------------------------------------------------------------
# Defaults when unset: 1.75 / 2.25 / 0.035 / 2. These names are shared with
# the CLI, so values set here apply to `predict` and `backtest` too.
MIN_ODDS=1.80
MAX_ODDS=2.10
MIN_EV=0.035
MAX_DAILY_PICKS=2
# TIMEZONE=Europe/Rome
# RUN_TIME=10:00              # for `agent schedule`
# PICK_HORIZON_HOURS=36       # only fixtures kicking off within this window
# MIN_LEAD_MINUTES=60
# NOTIFY_NO_PICKS=true        # send a short message on days without a pick
# MODEL_WEIGHT=0.35           # Dixon-Coles weight vs de-vigged Pinnacle
# MIN_TEAM_MATCHES=10         # ignore the model for teams with fewer matches
# BANKROLL=1000

# ODDS_API_DAILY_RESERVE=12     # credits kept per day left in the month for the odds fetch
# CALIBRATE_TOTALS=true         # recalibrate Over/Under probabilities, refit monthly
# CALIBRATION_REFRESH_DAYS=30

# --- Risk overrides (src/engine/risk.py); 0 or [] switches a rule off ----------
# EXTREME_LINE_MIN_EV=0.12      # EV floor for Over 3.5+ / Under 1.5- (rule 1)
# EXTREME_OVER_FROM=3.5
# EXTREME_UNDER_TO=1.5
# SANDBOX_LEAGUES=[]            # e.g. ["ligue-1"]: paper-traded, never sent (rule 2)
# BIG_MATCH_TOP_N=7             # both sides in the league's top-N attacks...
# BIG_MATCH_UNDER_PENALTY=0     # ...e.g. 0.035 takes 3.5 points off Under 2.5 (rule 3)

# --- Optional: Claude writes the two-sentence reasoning -----------------------
# Without a key, a deterministic template writes it from the same facts.
# ANTHROPIC_API_KEY=
# REASONING_MODEL=claude-opus-5
# REASONING_LANGUAGE=English

# --- Storage ----------------------------------------------------------------
DB_PATH=data/football.duckdb
